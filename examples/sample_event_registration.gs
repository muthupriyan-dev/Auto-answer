/**
 * Sample Google Apps Script generated by FormCraft AI
 * Creates a professional Event Registration Form with sections, validation, and confirmation message.
 *
 * How to run:
 * 1. Open https://script.google.com
 * 2. Create a New Project and paste this code.
 * 3. Run createEventRegistrationForm() and authorize permissions.
 * 4. Check the Execution Log for the public and edit URLs.
 */
function createEventRegistrationForm() {
  // 1. Initialize Form
  const form = FormApp.create('Tech Innovation Summit 2026 - Registration');
  form.setDescription('Join industry leaders for a 2-day conference on AI and cloud architecture.\nPlease complete all required fields.')
      .setProgressBar(true)
      .setAllowResponseEdits(true)
      .setLimitOneResponsePerUser(false)
      .setConfirmationMessage('Thank you for registering! We have recorded your response. Check your email for event updates.');

  // --- SECTION 1: Personal Details ---
  const nameItem = form.addTextItem();
  nameItem.setTitle('Full Name')
          .setHelpText('Enter your first and last name')
          .setRequired(true);

  // Email with Regex Validation
  const emailItem = form.addTextItem();
  emailItem.setTitle('Work Email Address')
           .setRequired(true);
  const emailValidation = FormApp.createTextValidation()
      .requireTextIsEmail()
      .setHelpText('Please enter a valid email address.')
      .build();
  emailItem.setValidation(emailValidation);

  const orgItem = form.addTextItem();
  orgItem.setTitle('Company / University / Organization')
         .setRequired(true);

  const roleItem = form.addListItem();
  roleItem.setTitle('Current Role / Title')
          .setChoiceValues([
            'Software Engineer / Architect',
            'Product Manager',
            'Data Scientist / AI Researcher',
            'Founder / C-Level Executive',
            'Student / Academic',
            'Other'
          ])
          .setRequired(true);

  // --- SECTION 2: Attendance & Preferences ---
  form.addPageBreakItem()
      .setTitle('Attendance & Logistics')
      .setHelpText('Help us prepare seating and dietary accommodations.');

  const passItem = form.addMultipleChoiceItem();
  passItem.setTitle('Ticket Type')
          .setChoiceValues([
            'Full Conference (Day 1 & Day 2) - In-Person',
            'Day 1 Only - In-Person',
            'Day 2 Only - In-Person',
            'Virtual Livestream Access'
          ])
          .setRequired(true);

  const workshopItem = form.addCheckboxItem();
  workshopItem.setTitle('Select Workshops you plan to attend (Optional)')
              .setChoiceValues([
                'Building Production Agentic AI',
                'Advanced Kubernetes & Cloud Native',
                'Designing Scalable Event-Driven APIs',
                'Prompt Engineering Masterclass'
              ]);

  const dietaryItem = form.addListItem();
  dietaryItem.setTitle('Dietary Requirements')
             .setChoiceValues([
               'Standard / No Restrictions',
               'Vegetarian',
               'Vegan',
               'Halal',
               'Kosher',
               'Gluten-Free'
             ])
             .setRequired(true);

  // --- SECTION 3: Feedback & Additional Info ---
  form.addPageBreakItem()
      .setTitle('Final Details');

  const expItem = form.addScaleItem();
  expItem.setTitle('How many years of industry experience do you have?')
         .setBounds(1, 10)
         .setLabels('1 Year or less', '10+ Years')
         .setRequired(false);

  const commentsItem = form.addParagraphTextItem();
  commentsItem.setTitle('Special Requests or Questions for Speakers')
              .setRequired(false);

  // Output Links
  Logger.log('=== FORM CREATED SUCCESSFULLY ===');
  Logger.log('Edit URL: ' + form.getEditUrl());
  Logger.log('Public URL: ' + form.getPublishedUrl());
}
