# Gemini AI Google Forms Assistant - Environment Configuration
# Copy this file to .env and fill in your values. Never commit .env!

# Port for the Express backend server
PORT=3000

# Google Gemini API Key (Obtain from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_actual_gemini_api_key_here

# Gemini Model identifier
# Recommended: gemini-2.5-flash, gemini-1.5-flash, or gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash

# REQUIRED: shared secret between the extension and this backend.
# Paste the SAME value in the extension popup ("API Key" field).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_SECRET=change_me_to_a_long_random_string

# Allowed origins for CORS (comma-separated).
# Leave EMPTY to allow only chrome-extension:// origins (recommended).
# To restrict to ONE extension, list it: chrome-extension://<your-extension-id>
# Use "*" only for local testing.
ALLOWED_ORIGINS=

# Number of reverse proxies in front of the app (Render/Railway = 1).
# Needed so the rate limiter sees each user's real IP.
TRUST_PROXY=1

# Rate Limiting: Max requests per 15 minutes per IP
RATE_LIMIT_MAX=100

# Local testing only: run WITHOUT an API key. Never set this on a deployed server.
# ALLOW_NO_AUTH=true
