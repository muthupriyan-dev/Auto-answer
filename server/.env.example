# Gemini AI Google Forms Assistant - Environment Configuration
# Copy this file to .env and fill in your values. Never commit .env!

# Port for the Express backend server
PORT=3000

# Google Gemini API Key (Obtain from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_actual_gemini_api_key_here

# Gemini Model identifier
# Recommended: gemini-2.5-flash, gemini-1.5-flash, or gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Allowed Frontend Origins for CORS (comma-separated or chrome-extension://<id>)
# Use "*" during local testing with unpacked extension, or specify your extension ID
ALLOWED_ORIGINS=*

# Rate Limiting: Max requests per 15 minutes per IP
RATE_LIMIT_MAX=100
